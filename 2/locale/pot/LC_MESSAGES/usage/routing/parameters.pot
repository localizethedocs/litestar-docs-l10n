#: ../../../usage/routing/parameters.rst:31
msgid ""
"Each parameter source has two equivalent declaration forms: a marker type "
"alias for the common case, and an :class:`~typing.Annotated` form for when "
"extra configuration is needed:"
msgstr ""

#: ../../../usage/routing/parameters.rst:0
msgid "Marker form"
msgstr ""

#: ../../../usage/routing/parameters.rst:40
msgid ""
"from litestar import get\n"
"from litestar.params import FromCookie, FromHeader, FromPath, FromQuery\n"
"\n"
"@get(\"/{user_id:int}\")\n"
"async def handler(\n"
"    user_id: FromPath[int],\n"
"    limit: FromQuery[int],\n"
"    token: FromHeader[str],\n"
"    session: FromCookie[str],\n"
") -> None: ..."
msgstr ""

#: ../../../usage/routing/parameters.rst:0
msgid "Annotated form"
msgstr ""

#: ../../../usage/routing/parameters.rst:0
msgid "Python 3.8+"
msgstr ""

#: ../../../usage/routing/parameters.rst:55
msgid ""
"from typing_extensions import Annotated\n"
"\n"
"from litestar import get\n"
"from litestar.params import (\n"
"    CookieParameter,\n"
"    HeaderParameter,\n"
"    PathParameter,\n"
"    QueryParameter,\n"
")\n"
"\n"
"@get(\"/{user_id:int}\")\n"
"async def handler(\n"
"    user_id: Annotated[int, PathParameter(ge=1)],\n"
"    limit: Annotated[int, QueryParameter(gt=0, le=100)],\n"
"    token: Annotated[str, HeaderParameter(name=\"X-API-KEY\")],\n"
"    session: Annotated[str, CookieParameter(name=\"session-id\")],\n"
") -> None: ..."
msgstr ""

#: ../../../usage/routing/parameters.rst:0
msgid "Python 3.9+"
msgstr ""

#: ../../../usage/routing/parameters.rst:55
msgid ""
"from typing import Annotated\n"
"\n"
"from litestar import get\n"
"from litestar.params import (\n"
"    CookieParameter,\n"
"    HeaderParameter,\n"
"    PathParameter,\n"
"    QueryParameter,\n"
")\n"
"\n"
"@get(\"/{user_id:int}\")\n"
"async def handler(\n"
"    user_id: Annotated[int, PathParameter(ge=1)],\n"
"    limit: Annotated[int, QueryParameter(gt=0, le=100)],\n"
"    token: Annotated[str, HeaderParameter(name=\"X-API-KEY\")],\n"
"    session: Annotated[str, CookieParameter(name=\"session-id\")],\n"
") -> None: ..."
msgstr ""

#: ../../../usage/routing/parameters.rst:74
msgid ""
"The two forms are equivalent: ``FromQuery[T]`` is just an alias for "
"``Annotated[T, QueryParameter()]``. Prefer the marker form when no extra "
"configuration is needed."
msgstr ""

#: ../../../usage/routing/parameters.rst:78
msgid "Technical details"
msgstr ""

#: ../../../usage/routing/parameters.rst:81
msgid ""
"These :term:`parameters <parameter>` will be parsed from the function "
"signature and used to generate an internal data model. This model in turn "
"will be used to validate the parameters and generate the OpenAPI schema"
msgstr ""

#: ../../../usage/routing/parameters.rst:87
msgid ":doc:`/topics/explicit_declarations`"
msgstr ""

#: ../../../usage/routing/parameters.rst:91
msgid "Optional, required and nullable"
msgstr ""

#: ../../../usage/routing/parameters.rst:93
msgid ""
"Just like function parameters in Python, request parameters can be required, "
"optional or have a default value."
msgstr ""

#: ../../../usage/routing/parameters.rst:96
msgid "Parameters declared without any default are required"
msgstr ""

#: ../../../usage/routing/parameters.rst:97
msgid "Parameters declared with a default are optional"
msgstr ""

#: ../../../usage/routing/parameters.rst:98
msgid ""
"Parameters declared with ``| None`` are *nullable*, i.e. the may take a "
"``None`` value; they are still required, unless they are given a default "
"value"
msgstr ""

#: ../../../usage/routing/parameters.rst:101
msgid ""
"Defaults work exactly like defaults in regular function parameters: If the "
"value is missing from the request, the handler is called with the default:"
msgstr ""

#: ../../../usage/routing/parameters.rst:105
msgid "Defining a default value for a query parameter"
msgstr ""

#: ../../../usage/routing/parameters.rst:105
msgid ""
"from typing import Dict\n"
"\n"
"from litestar import Litestar, get\n"
"from litestar.params import FromQuery\n"
"\n"
"\n"
"@get(\"/\", sync_to_thread=False)\n"
"def index(param: FromQuery[str] = \"hello\") -> Dict[str, str]:\n"
"    return {\"param\": param}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[index])"
msgstr ""

#: ../../../usage/routing/parameters.rst:105
msgid ""
"from litestar import Litestar, get\n"
"from litestar.params import FromQuery\n"
"\n"
"\n"
"@get(\"/\", sync_to_thread=False)\n"
"def index(param: FromQuery[str] = \"hello\") -> dict[str, str]:\n"
"    return {\"param\": param}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[index])"
msgstr ""

