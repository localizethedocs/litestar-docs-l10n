#: ../../../../litestar/middleware/allowed_hosts.py:docstring of
#: litestar.middleware.allowed_hosts.AllowedHostsMiddleware.__init__:3
msgid ""
"A list of trusted hosts. Use ``*`` to allow all hosts, or prefix domains "
"with ``*.`` to allow all subdomains. Wildcard placement is validated "
"by :class:`~litestar.config.allowed_hosts.AllowedHostsConfig`, not here."
msgstr ""

#: ../../../../litestar/middleware/allowed_hosts.py:docstring of
#: litestar.middleware.allowed_hosts.AllowedHostsMiddleware.__init__:6
msgid ""
"A pattern or list of patterns to skip, matched against the request path."
msgstr ""

#: ../../../../litestar/middleware/allowed_hosts.py:docstring of
#: litestar.middleware.allowed_hosts.AllowedHostsMiddleware.__init__:7
msgid ""
"A pattern or list of patterns to skip, matched against the handler path at "
"startup. "
"See :attr:`~litestar.middleware.ASGIMiddleware.exclude_path_pattern`."
msgstr ""

#: ../../../../litestar/middleware/allowed_hosts.py:docstring of
#: litestar.middleware.allowed_hosts.AllowedHostsMiddleware.__init__:9
msgid ""
"An identifier to use on routes to disable the host check for a particular "
"route."
msgstr ""

#: ../../../../litestar/middleware/allowed_hosts.py:docstring of
#: litestar.middleware.allowed_hosts.AllowedHostsMiddleware.__init__:11
msgid ""
"ASGI scopes processed by the middleware; if ``None`` or empty, ``http``, "
"``websocket`` and ASGI route handlers are all processed. Mounted ASGI apps "
"stay wrapped regardless, with their connections filtered by scope type."
msgstr ""

#: ../../../../litestar/middleware/allowed_hosts.py:docstring of
#: litestar.middleware.allowed_hosts.AllowedHostsMiddleware.__init__:14
msgid ""
"A boolean dictating whether to redirect requests that start with ``www.`` "
"and otherwise match a trusted host."
msgstr ""

