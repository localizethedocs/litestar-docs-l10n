"through differing predecessors in each registry, will create unique values "
"below the lifetimes of its scope."
msgstr ""

#: ../../../../litestar/di/__init__.py:docstring of
#: litestar.di.registry.check_divergence:7
msgid ""
"@provide(scope=\"app\", key=\"session\")\n"
"async def create_session(engine: NamedDependency[Engine]) -> Session:\n"
"    with Session(bind=engine) as session:\n"
"        yield session\n"
"\n"
"@provide(scope=\"app\", key=\"engine\")\n"
"async def engine_one() -> str:\n"
"    return create_engine(<some params>)\n"
"\n"
"@provide(scope=\"app\", key=\"engine\")\n"
"async def engine_two() -> str:\n"
"    return create_engine(<some other params>)\n"
"\n"
"alice = DIRegistry(\"alice\", [create_session, engine_one])\n"
"bob = DIRegistry(\"bob\", [create_session, engine_two])\n"
"\n"
"app_ctx = DIContext(registry=DIRegistry(), scope=\"app\")\n"
"alice_ctx = DIContext(alice, scope=\"request\", parent=app_ctx)\n"
"bob_ctx = DIContext(alice, scope=\"request\", parent=app_ctx)\n"
"\n"
"await alice_ctx.solve(\"session\")  # there is now an 'engine' and a "
"'session' in app_ctx\n"
"await bob_ctx.solve(\"session\")  # a distinct 'engine' and a 'session' are "
"created in app_ctx"
msgstr ""

#: ../../../../litestar/di/__init__.py:docstring of
#: litestar.di.registry.check_divergence:32
msgid ""
"In this example, both registries share the provider for the 'session' key, "
"but have different providers for the 'engine' key. Since 'session' depends "
"on 'engine', this is a divergence. When resolving 'session' through "
"'alice_ctx' , it must get a different 'engine' then when resolved through "
"'bob_ctx', which the context will solve by invoking 'create_session' again, "
"even if a value for its key is already present in 'app_ctx'."
msgstr ""

