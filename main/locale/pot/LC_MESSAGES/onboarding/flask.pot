#: ../../../onboarding/flask.rst:281
msgid "Per-request state"
msgstr ""

#: ../../../onboarding/flask.rst:283
msgid ""
"Flask uses ``flask.g`` for values that should live for the duration of a "
"single request. Litestar uses ``request.state``, a mutable mapping attached "
"to the request."
msgstr ""

#: ../../../onboarding/flask.rst:292
msgid ""
"from flask import Flask, g, request\n"
"\n"
"app = Flask(__name__)\n"
"\n"
"@app.before_request\n"
"def set_user() -> None:\n"
"    g.user = request.headers.get(\"x-user\", \"anonymous\")\n"
"\n"
"@app.get(\"/\")\n"
"def index():\n"
"    return {\"user\": g.user}"
msgstr ""

#: ../../../onboarding/flask.rst:309
msgid ""
"from litestar import Litestar, Request, get\n"
"\n"
"\n"
"def set_user_on_request(request: Request) -> None:\n"
"    request.state[\"user\"] = request.headers.get(\"x-user\", "
"\"anonymous\")\n"
"\n"
"\n"
"@get(\"/\", sync_to_thread=False)\n"
"def index(request: Request) -> dict[str, str | None]:\n"
"    return {\"user\": request.state[\"user\"]}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[index], before_request=set_user_on_request)"
msgstr ""

#: ../../../onboarding/flask.rst:313
msgid "The current application"
msgstr ""

#: ../../../onboarding/flask.rst:315
msgid ""
"``flask.current_app`` is a thread-local proxy. Litestar exposes the "
"application as ``request.app``, or as an ``app`` parameter on lifecycle "
"hooks and middleware factories."
msgstr ""

#: ../../../onboarding/flask.rst:320
msgid "File uploads"
msgstr ""

#: ../../../onboarding/flask.rst:322
msgid ""
"Flask exposes uploaded files through ``request.files``. Litestar binds them "
"to a ``data`` parameter typed as :class:`~litestar.datastructures."
"UploadFile` (or a list of them), with ``media_type`` set to :class:"
"`RequestEncodingType.URL_ENCODED <litestar.enums.RequestEncodingType>` or :"
"class:`RequestEncodingType.MULTI_PART <litestar.enums.RequestEncodingType>`"
msgstr ""

#: ../../../onboarding/flask.rst:334
msgid ""
"from flask import Flask, request\n"
"\n"
"app = Flask(__name__)\n"
"\n"
"@app.post(\"/upload\")\n"
"def upload():\n"
"    f = request.files[\"data\"]\n"
"    return {\"filename\": f.filename}"
msgstr ""

#: ../../../onboarding/flask.rst:348
msgid ""
"from typing import Annotated\n"
"\n"
"from litestar import Litestar, post\n"
"from litestar.datastructures import UploadFile\n"
"from litestar.enums import RequestEncodingType\n"
"from litestar.params import Body\n"
"\n"
"\n"
"@post(\"/upload\")\n"
"async def upload(\n"
"    data: Annotated[UploadFile, Body(media_type=RequestEncodingType."
"MULTI_PART)],\n"
") -> dict[str, str | None]:\n"
"    return {\"filename\": data.filename}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[upload])"
msgstr ""

#: ../../../onboarding/flask.rst:352
msgid "Producing responses"
msgstr ""

#: ../../../onboarding/flask.rst:355
msgid "Status codes"
msgstr ""

#: ../../../onboarding/flask.rst:357
msgid ""
"Flask overrides the default ``200`` by returning a ``(body, status)`` tuple. "
"Litestar declares the status code on the decorator with ``status_code=`` "
"when it is fixed for the handler, and on the :class:`~litestar.response."
"Response` instance when it depends on the request."
msgstr ""

#: ../../../onboarding/flask.rst:362
msgid ""
"Litestar picks the status code from the HTTP method by default: ``POST`` "
"defaults to ``201 Created``, ``DELETE`` to ``204 No Content``, everything "
"else to ``200 OK``."
msgstr ""

#: ../../../onboarding/flask.rst:371
msgid ""
"from flask import Flask\n"
"\n"
"app = Flask(__name__)\n"
"\n"
"@app.get(\"/\")\n"
"def index():\n"
"    return \"not found\", 404"
msgstr ""

#: ../../../onboarding/flask.rst:384
msgid ""
"from litestar import Litestar, Response, get\n"
"\n"
"\n"
"@get(\"/static\", status_code=404, sync_to_thread=False)\n"
"def static_status() -> str:\n"
"    return \"not found\"\n"
"\n"
"\n"
"@get(\"/dynamic\", sync_to_thread=False)\n"
"def dynamic_status() -> Response[str]:\n"
"    return Response(\"not found\", status_code=404)\n"
"\n"
"\n"
"app = Litestar(route_handlers=[static_status, dynamic_status])"
msgstr ""

#: ../../../onboarding/flask.rst:388
msgid "Cookies and headers"
msgstr ""

#: ../../../onboarding/flask.rst:390
msgid ""
"Flask builds a response with ``make_response`` and mutates it. Litestar "
"offers two paths: declare static values on the decorator with "
"``response_cookies`` and ``response_headers``, or return a :class:`~litestar."
"response.Response` with ``cookies=`` and ``headers=`` when the values depend "
"on the request."
msgstr ""

#: ../../../onboarding/flask.rst:401
msgid ""
"from flask import Flask, make_response\n"
"\n"
"app = Flask(__name__)\n"
"\n"
"@app.get(\"/\")\n"
"def index():\n"
"    response = make_response(\"hello\")\n"
"    response.set_cookie(\"my-cookie\", \"cookie-value\")\n"
"    response.headers[\"my-header\"] = \"header-value\"\n"
"    return response"
msgstr ""

#: ../../../onboarding/flask.rst:417
msgid ""
"from litestar import Litestar, Response, get\n"
"from litestar.datastructures import Cookie\n"
"\n"
"\n"
"@get(\n"
"    \"/static\",\n"
"    response_headers={\"my-header\": \"header-value\"},\n"
"    response_cookies=[Cookie(key=\"my-cookie\", value=\"cookie-value\")],\n"
"    sync_to_thread=False,\n"
")\n"
"def static() -> str:\n"
"    return \"hello\"\n"
"\n"
"\n"
"@get(\"/dynamic\", sync_to_thread=False)\n"
"def dynamic() -> Response[str]:\n"
"    return Response(\n"
"        \"hello\",\n"
"        headers={\"my-header\": \"header-value\"},\n"
"        cookies=[Cookie(key=\"my-cookie\", value=\"cookie-value\")],\n"
"    )\n"
"\n"
"\n"
"app = Litestar(route_handlers=[static, dynamic])"
msgstr ""

