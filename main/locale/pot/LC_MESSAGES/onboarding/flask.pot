#: ../../../onboarding/flask.rst:65
msgid "Path parameters"
msgstr ""

#: ../../../onboarding/flask.rst:67
msgid ""
"Flask declares converters inline: ``<int:post_id>``. Litestar calls these "
"\"path parameters\", which are declared like ``/post/{post_id:int}``. The "
"handler can request a path parameter by annotating a function parameter "
"with :data:`~litestar.params.FromPath`. By default, Litestar will try to "
"inject a path parameter matching the function parameter name, but you can "
"also specify an alias (see :ref:`usage/routing/parameters:aliasing`)."
msgstr ""

#: ../../../onboarding/flask.rst:75
msgid ""
"The type defined in the path parameter does not have to match the function "
"parameter. The path parameter is what defines the input type, and what's "
"reflected in the OpenAPI schema. The function parameter is what will be "
"validated against."
msgstr ""

#: ../../../onboarding/flask.rst:85
msgid ""
"from flask import Flask\n"
"\n"
"app = Flask(__name__)\n"
"\n"
"@app.route(\"/user/<username>\")\n"
"def show_user_profile(username):\n"
"    return f\"User {username}\"\n"
"\n"
"@app.route(\"/post/<int:post_id>\")\n"
"def show_post(post_id):\n"
"    return f\"Post {post_id}\"\n"
"\n"
"@app.route(\"/path/<path:subpath>\")\n"
"def show_subpath(subpath):\n"
"    return f\"Subpath {subpath}\""
msgstr ""

#: ../../../onboarding/flask.rst:106
msgid ""
"import pathlib\n"
"\n"
"from litestar import Litestar, get\n"
"from litestar.params import FromPath\n"
"\n"
"\n"
"@get(\"/user/{username:str}\", sync_to_thread=False)\n"
"def show_user_profile(username: FromPath[str]) -> str:\n"
"    return f\"User {username}\"\n"
"\n"
"\n"
"@get(\"/post/{post_id:int}\", sync_to_thread=False)\n"
"def show_post(post_id: FromPath[int]) -> str:\n"
"    return f\"Post {post_id}\"\n"
"\n"
"\n"
"@get(\"/path/{subpath:path}\", sync_to_thread=False)\n"
"def show_subpath(subpath: FromPath[pathlib.Path]) -> str:\n"
"    return f\"Subpath {subpath}\"\n"
"\n"
"\n"
"app = Litestar(route_handlers=[show_user_profile, show_post, show_subpath])"
msgstr ""

