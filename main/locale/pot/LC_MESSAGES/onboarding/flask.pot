#: ../../../onboarding/flask.rst:471
msgid "URL lookup"
msgstr ""

#: ../../../onboarding/flask.rst:473
msgid ""
"Flask exposes ``url_for(endpoint, **params)`` as a module-level function. "
"Litestar exposes :meth:`request.url_for <litestar.connection.ASGIConnection."
"url_for>` on the request instead. The endpoint name comes from an explicit "
"``name=`` keyword on the handler decorator, the equivalent of Flask's view-"
"function name."
msgstr ""

#: ../../../onboarding/flask.rst:484
msgid ""
"from flask import url_for\n"
"\n"
"url_for(\"index\")"
msgstr ""

#: ../../../onboarding/flask.rst:493
msgid ""
"from litestar import Litestar, Request, get\n"
"from litestar.response import Redirect\n"
"\n"
"\n"
"@get(\"/\", name=\"index\", sync_to_thread=False)\n"
"def index() -> str:\n"
"    return \"hello\"\n"
"\n"
"\n"
"@get(\"/hello\", sync_to_thread=False)\n"
"def hello(request: Request) -> Redirect:\n"
"    return Redirect(path=request.url_for(\"index\"))\n"
"\n"
"\n"
"app = Litestar(route_handlers=[index, hello])"
msgstr ""

#: ../../../onboarding/flask.rst:497 ../../../onboarding/flask.rst:828
msgid "Templates"
msgstr ""

#: ../../../onboarding/flask.rst:499
msgid ""
"Flask ships Jinja2 and renders templates with ``render_template``. Litestar "
"treats templating as opt-in: Jinja2 is available through the "
"``litestar[jinja]`` extra, Mako through ``litestar[mako]``. The engine is "
"configured on the application through :class:`~litestar.template.config."
"TemplateConfig`, and each handler returns a :class:`~litestar.response."
"Template` — the equivalent of ``render_template``'s return value."
msgstr ""

#: ../../../onboarding/flask.rst:512
msgid ""
"from flask import Flask, render_template\n"
"\n"
"app = Flask(__name__)\n"
"\n"
"@app.route(\"/hello/<name>\")\n"
"def hello(name):\n"
"    return render_template(\"hello.html\", name=name)"
msgstr ""

#: ../../../onboarding/flask.rst:525
msgid ""
"from pathlib import Path\n"
"\n"
"from litestar import Litestar, get\n"
"from litestar.params import FromPath\n"
"from litestar.plugins.jinja import JinjaTemplateEngine\n"
"from litestar.response import Template\n"
"from litestar.template.config import TemplateConfig\n"
"\n"
"\n"
"@get(\"/hello/{name:str}\", sync_to_thread=False)\n"
"def hello(name: FromPath[str]) -> Template:\n"
"    return Template(\n"
"        template_str=\"<p>Hello, {{ name }}!</p>\",\n"
"        context={\"name\": name},\n"
"    )\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[hello],\n"
"    template_config=TemplateConfig(\n"
"        directory=Path(__file__).parent,\n"
"        engine=JinjaTemplateEngine,\n"
"    ),\n"
")"
msgstr ""

#: ../../../onboarding/flask.rst:529
msgid ":doc:`/usage/templating`"
msgstr ""

#: ../../../onboarding/flask.rst:533
msgid "Streaming responses"
msgstr ""

#: ../../../onboarding/flask.rst:535
msgid ""
"Flask streams by returning a generator wrapped in ``flask.Response``. In "
"Litestar, you can return a :class:`~litestar.response.Stream` built from a "
"sync or async iterator."
msgstr ""

#: ../../../onboarding/flask.rst:544
msgid ""
"from flask import Flask, Response\n"
"\n"
"app = Flask(__name__)\n"
"\n"
"@app.get(\"/stream\")\n"
"def stream():\n"
"    def gen():\n"
"        for i in range(3):\n"
"            yield f\"data: {i}\\n\\n\"\n"
"\n"
"    return Response(gen(), mimetype=\"text/event-stream\")"
msgstr ""

#: ../../../onboarding/flask.rst:561
msgid ""
"from collections.abc import AsyncIterator\n"
"\n"
"from litestar import Litestar, get\n"
"from litestar.response import Stream\n"
"\n"
"\n"
"async def event_source() -> AsyncIterator[bytes]:\n"
"    for i in range(3):\n"
"        yield f\"data: {i}\\n\\n\".encode()\n"
"\n"
"\n"
"@get(\"/stream\")\n"
"async def stream() -> Stream:\n"
"    return Stream(event_source(), media_type=\"text/event-stream\")\n"
"\n"
"\n"
"app = Litestar(route_handlers=[stream])"
msgstr ""

#: ../../../onboarding/flask.rst:565
msgid "Exceptions and error responses"
msgstr ""

#: ../../../onboarding/flask.rst:567
msgid ""
"Flask aborts with ``abort(code, description)``. Litestar raises an :class:"
"`~litestar.exceptions.HTTPException` (or a subclass) directly."
msgstr ""

#: ../../../onboarding/flask.rst:576
msgid ""
"from flask import Flask, abort\n"
"\n"
"app = Flask(__name__)\n"
"\n"
"@app.get(\"/\")\n"
"def index():\n"
"    abort(400, \"this did not work\")"
msgstr ""

#: ../../../onboarding/flask.rst:589
msgid ""
"from litestar import Litestar, get\n"
"from litestar.exceptions import HTTPException\n"
"\n"
"\n"
"@get(\"/\", sync_to_thread=False)\n"
"def index() -> None:\n"
"    raise HTTPException(status_code=400, detail=\"this did not work\")\n"
"\n"
"\n"
"app = Litestar(route_handlers=[index])"
msgstr ""

#: ../../../onboarding/flask.rst:593
msgid ":doc:`/usage/exceptions`"
msgstr ""

#: ../../../onboarding/flask.rst:597
msgid "Custom exception handlers"
msgstr ""

#: ../../../onboarding/flask.rst:599
msgid ""
"Flask registers handlers through ``@app.errorhandler``. Litestar accepts a "
"mapping from an exception class or status code to a handler callable."
msgstr ""

#: ../../../onboarding/flask.rst:603
msgid ""
"Exception handling is part of Litestar's layered architecture, so these can "
"be declared on applications, routers, controllers or route handlers."
msgstr ""

#: ../../../onboarding/flask.rst:612
msgid ""
"from flask import Flask\n"
"from werkzeug.exceptions import HTTPException\n"
"\n"
"app = Flask(__name__)\n"
"\n"
"@app.errorhandler(HTTPException)\n"
"def handle_exception(e):\n"
"    return {\"detail\": e.description}, e.code"
msgstr ""

#: ../../../onboarding/flask.rst:626
msgid ""
"from litestar import Litestar, Request, Response, get\n"
"from litestar.exceptions import HTTPException\n"
"\n"
"\n"
"def handle_http_exception(request: Request, exception: HTTPException) -> "
"Response[dict[str, str]]:\n"
"    return Response(\n"
"        {\"detail\": exception.detail},\n"
"        status_code=exception.status_code,\n"
"    )\n"
"\n"
"\n"
"@get(\"/\", sync_to_thread=False)\n"
"def index() -> None:\n"
"    raise HTTPException(status_code=400, detail=\"this did not work\")\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[index],\n"
"    exception_handlers={HTTPException: handle_http_exception},\n"
")"
msgstr ""

#: ../../../onboarding/flask.rst:630
msgid ":ref:`usage/exceptions:exception handling`"
msgstr ""

#: ../../../onboarding/flask.rst:634
msgid "Before and after request hooks"
msgstr ""

#: ../../../onboarding/flask.rst:636
msgid ""
"Flask uses ``@app.before_request`` and ``@app.after_request``. Litestar "
"accepts the same callables through the ``before_request`` and "
"``after_request`` keyword arguments on any layer."
msgstr ""

#: ../../../onboarding/flask.rst:641
msgid ""
"Lifecycle hooks are part of Litestar's layered architecture, so these can be "
"declared on applications, routers, controllers or route handlers"
msgstr ""

#: ../../../onboarding/flask.rst:650
msgid ""
"from flask import Flask, g\n"
"\n"
"app = Flask(__name__)\n"
"\n"
"@app.before_request\n"
"def attach_user() -> None:\n"
"    g.user = \"alice\"\n"
"\n"
"@app.after_request\n"
"def wrap_text(response):\n"
"    if response.mimetype == \"text/plain\":\n"
"        return {\"value\": response.get_data(as_text=True)}\n"
"    return response"
msgstr ""

#: ../../../onboarding/flask.rst:669
msgid ""
"from litestar import Litestar, MediaType, Request, Response, get\n"
"\n"
"\n"
"def attach_user(request: Request) -> None:\n"
"    request.state[\"user\"] = \"alice\"\n"
"\n"
"\n"
"def wrap_text_responses(response: Response) -> Response:\n"
"    if response.media_type == MediaType.TEXT:\n"
"        return Response({\"value\": response.content})\n"
"    return response\n"
"\n"
"\n"
"@get(\"/hello\", sync_to_thread=False)\n"
"def hello(request: Request) -> str:\n"
"    return f\"hello, {request.state['user']}\"\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[hello],\n"
"    before_request=attach_user,\n"
"    after_request=wrap_text_responses,\n"
")"
msgstr ""

#: ../../../onboarding/flask.rst:673
msgid ":doc:`/usage/lifecycle-hooks`"
msgstr ""

#: ../../../onboarding/flask.rst:677 ../../../onboarding/flask.rst:846
msgid "Sessions"
msgstr ""

#: ../../../onboarding/flask.rst:679
msgid ""
"Flask exposes ``flask.session`` as a thread-local dictionary backed by a "
"signed cookie. Litestar provides sessions via a session middleware, and "
"exposes ``request.session`` as a mutable mapping. Two backends are "
"available: :class:`~litestar.middleware.session.server_side."
"ServerSideSessionConfig` keeps the data on the server and a session id in "
"the cookie; :class:`~litestar.middleware.session.client_side."
"CookieBackendConfig` stores encrypted data in the cookie itself (closest to "
"Flask's default)."
msgstr ""

#: ../../../onboarding/flask.rst:693
msgid ""
"from flask import Flask, session\n"
"\n"
"app = Flask(__name__)\n"
"app.secret_key = \"...\"\n"
"\n"
"@app.post(\"/login\")\n"
"def login():\n"
"    session[\"user\"] = \"alice\"\n"
"    return \"\"\n"
"\n"
"@app.get(\"/whoami\")\n"
"def whoami():\n"
"    return {\"user\": session.get(\"user\")}"
msgstr ""

#: ../../../onboarding/flask.rst:712
msgid ""
"from typing import Any\n"
"\n"
"from litestar import Litestar, Request, get, post\n"
"from litestar.middleware.session.server_side import ServerSideSessionConfig\n"
"\n"
"session_config = ServerSideSessionConfig()\n"
"\n"
"\n"
"@post(\"/login\", sync_to_thread=False)\n"
"def login(request: Request) -> None:\n"
"    request.set_session({\"user\": \"alice\"})\n"
"\n"
"\n"
"@get(\"/whoami\", sync_to_thread=False)\n"
"def whoami(request: Request) -> dict[str, Any]:\n"
"    return {\"user\": request.session.get(\"user\")}\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[login, whoami],\n"
"    middleware=[session_config.middleware],\n"
")"
msgstr ""

#: ../../../onboarding/flask.rst:716
msgid ":doc:`/usage/middleware/builtin-middleware`"
msgstr ""

#: ../../../onboarding/flask.rst:720 ../../../onboarding/flask.rst:826
msgid "Static files"
msgstr ""

#: ../../../onboarding/flask.rst:722
msgid ""
"Flask serves files from a folder named ``static`` automatically. Litestar "
"offers an equivalent in :func:`~litestar.static_files."
"create_static_files_router`, which can be registered to serve files from a "
"configured directory:"
msgstr ""

#: ../../../onboarding/flask.rst:727
msgid ""
"from pathlib import Path\n"
"\n"
"from litestar import Litestar\n"
"from litestar.static_files import create_static_files_router\n"
"\n"
"ASSETS_DIR = Path(__file__).parent / \"assets\"\n"
"\n"
"\n"
"def ensure_assets() -> None:\n"
"    ASSETS_DIR.mkdir(exist_ok=True)\n"
"    ASSETS_DIR.joinpath(\"hello.txt\").write_text(\"Hello, world!\")\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[\n"
"        create_static_files_router(path=\"/static\", "
"directories=[ASSETS_DIR]),\n"
"    ],\n"
"    on_startup=[ensure_assets],\n"
")"
msgstr ""

#: ../../../onboarding/flask.rst:731
msgid ":doc:`/usage/static-files`"
msgstr ""

#: ../../../onboarding/flask.rst:735
msgid "WebSockets"
msgstr ""

#: ../../../onboarding/flask.rst:737
msgid ""
"Flask does not include WebSocket support natively, but `flask-sock`` and "
"``flask-socketio`` are popular extensions from the ecosystem. Litestar does "
"include native WebSocket support, coming in three different shapes:"
msgstr ""

#: ../../../onboarding/flask.rst:741
msgid ""
":func:`~litestar.handlers.websocket`: direct connection handling via raw "
"`ASGI WebSockets <https://asgi.readthedocs.io/en/latest/specs/www."
"html#websocket>`_"
msgstr ""

#: ../../../onboarding/flask.rst:742
msgid ""
":func:`~litestar.handlers.websocket_listener`: Per-message callback style "
"that takes and returns typed values; the framework handles accept, the "
"receive loop, and serialisation."
msgstr ""

#: ../../../onboarding/flask.rst:745
msgid ""
":func:`~litestar.handlers.websocket_stream`: Async generator to produce "
"messages that are pushed to the WebSocket;  the framework handles accept, "
"the receive loop, and serialisation."
msgstr ""

#: ../../../onboarding/flask.rst:750
msgid ""
"from litestar import Litestar, websocket_listener\n"
"\n"
"\n"
"@websocket_listener(\"/ws\")\n"
"async def chat(data: str) -> str:\n"
"    return f\"you said: {data}\"\n"
"\n"
"\n"
"app = Litestar(route_handlers=[chat])"
msgstr ""

#: ../../../onboarding/flask.rst:752
msgid ""
"For broadcast and pub/sub patterns, pair these handlers with the :doc:"
"`channels </usage/channels>` plugin. Channels handles per-channel "
"subscriptions, history, and inter-process fan-out through a pluggable "
"broker, and can generate WebSocket route handlers that publish incoming "
"events to subscribed clients."
msgstr ""

#: ../../../onboarding/flask.rst:759
msgid ":doc:`/usage/websockets`"
msgstr ""

#: ../../../onboarding/flask.rst:763
msgid "Testing"
msgstr ""

#: ../../../onboarding/flask.rst:765
msgid ""
"Flask exposes ``app.test_client()``. Litestar offers :class:`~litestar."
"testing.TestClient` (which wraps an existing app) and :func:`~litestar."
"testing.create_test_client` (which builds a fresh app from the same options "
"as :class:`~litestar.app.Litestar`)."
msgstr ""

#: ../../../onboarding/flask.rst:776
msgid ""
"def test_index() -> None:\n"
"    client = app.test_client()\n"
"    response = client.get(\"/\")\n"
"    assert response.status_code == 200\n"
"    assert response.text == \"Index Page\""
msgstr ""

#: ../../../onboarding/flask.rst:787
msgid ""
"from litestar import get\n"
"from litestar.status_codes import HTTP_200_OK\n"
"from litestar.testing import create_test_client\n"
"\n"
"\n"
"@get(\"/\", sync_to_thread=False)\n"
"def index() -> str:\n"
"    return \"Index Page\"\n"
"\n"
"\n"
"def test_index() -> None:\n"
"    with create_test_client(route_handlers=[index]) as client:\n"
"        response = client.get(\"/\")\n"
"    assert response.status_code == HTTP_200_OK\n"
"    assert response.text == \"Index Page\""
msgstr ""

