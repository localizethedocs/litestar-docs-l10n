#: ../../../onboarding/fastapi.rst:85
msgid "Routers"
msgstr ""

#: ../../../onboarding/fastapi.rst:87
msgid ""
"A few small differences between Litestar's :class:`Router` and FastAPI / "
"Starlette's:"
msgstr ""

#: ../../../onboarding/fastapi.rst:89
msgid ""
"A Litestar ``Router`` is not itself an ASGI application. It groups handlers "
"and options. Routers are \"flattened\" into simple handlers during "
"registration"
msgstr ""

#: ../../../onboarding/fastapi.rst:91
msgid "A Litestar ``Router`` does not expose decorators"
msgstr ""

#: ../../../onboarding/fastapi.rst:92
msgid ""
"A Litestar ``Router`` does not run lifecycle hooks. Lifecycle hooks can only "
"be registered on the application. See :doc:`/usage/lifecycle-hooks` for more "
"information"
msgstr ""

#: ../../../onboarding/fastapi.rst:97
msgid "Host-based routing"
msgstr ""

#: ../../../onboarding/fastapi.rst:99
msgid ""
"Litestar does not support dispatching requests by the ``Host`` header. Run "
"each host as its own application behind a reverse proxy such as `nginx "
"<https://www.nginx.com>`_ or `traefik <https://traefik.io>`_."
msgstr ""

#: ../../../onboarding/fastapi.rst:105 ../../../onboarding/fastapi.rst:874
msgid "Lifespan"
msgstr ""

#: ../../../onboarding/fastapi.rst:107
msgid "Litestar uses the async context manager pattern as Starlette/FastAPI:"
msgstr ""

#: ../../../onboarding/fastapi.rst:115
msgid ""
"from contextlib import asynccontextmanager\n"
"\n"
"@asynccontextmanager\n"
"async def lifespan(app: FastAPI):\n"
"    # setup\n"
"    yield\n"
"    # teardown\n"
"\n"
"app = FastAPI(lifespan=lifespan)"
msgstr ""

#: ../../../onboarding/fastapi.rst:130
msgid ""
"from collections.abc import AsyncIterator\n"
"from contextlib import asynccontextmanager\n"
"\n"
"from litestar import Litestar, get\n"
"\n"
"\n"
"@asynccontextmanager\n"
"async def lifespan(app: Litestar) -> AsyncIterator[None]:\n"
"    # Setup code runs before the application starts accepting requests.\n"
"    yield\n"
"    # Teardown code runs after the application has stopped.\n"
"\n"
"\n"
"@get(\"/\")\n"
"async def index() -> dict[str, str]:\n"
"    return {\"hello\": \"world\"}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[index], lifespan=[lifespan])"
msgstr ""

#: ../../../onboarding/fastapi.rst:134 ../../../onboarding/fastapi.rst:872
msgid "Application state"
msgstr ""

#: ../../../onboarding/fastapi.rst:136
msgid ""
"Application-scoped data lives on :class:`~litestar.datastructures.State`, "
"the equivalent of FastAPI's ``app.state``. State seeded on the application "
"is available to dependencies through the ``state`` parameter and to handlers "
"through ``request.app.state``. Per-request data lives on ``request.state`` "
"instead, and is wiped between requests."
msgstr ""

#: ../../../onboarding/fastapi.rst:147
msgid ""
"from fastapi import Request\n"
"\n"
"async def get_arq_redis(request: Request) -> ArqRedis:\n"
"    return request.state.arq_redis"
msgstr ""

#: ../../../onboarding/fastapi.rst:157
msgid ""
"from typing import cast\n"
"\n"
"from litestar import Litestar, get\n"
"from litestar.datastructures import State\n"
"from litestar.di import Provide\n"
"\n"
"\n"
"class ArqRedis:\n"
"    \"\"\"Stand-in for an ``arq`` Redis client.\"\"\"\n"
"\n"
"\n"
"async def get_arq_redis(state: State) -> ArqRedis:\n"
"    return cast(ArqRedis, state.arq_redis)\n"
"\n"
"\n"
"@get(\"/\", dependencies={\"arq_redis\": Provide(get_arq_redis)})\n"
"async def handler(arq_redis: ArqRedis) -> dict[str, str]:\n"
"    return {\"type\": type(arq_redis).__name__}\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[handler],\n"
"    state=State({\"arq_redis\": ArqRedis()}),\n"
")"
msgstr ""

#: ../../../onboarding/fastapi.rst:161
msgid "Handlers and request data"
msgstr ""

#: ../../../onboarding/fastapi.rst:164
msgid "Path and query parameters"
msgstr ""

#: ../../../onboarding/fastapi.rst:166
msgid ""
"FastAPI allows declaring path and query parameters implicitly; If a function "
"parameter of the same name is detected, the path / query parameter will be "
"injected into it. Litestar uses the same mechanism but makes it explicit: "
"The corresponding parameters must be marked with :data:`~litestar.params."
"FromPath` and :data:`~litestar.params.FromQuery` respectively:"
msgstr ""

#: ../../../onboarding/fastapi.rst:178
msgid ""
"@app.get(\"/{some_path}\")\n"
"async def handler(some_path: str, some_query: int) -> None:\n"
"    return None"
msgstr ""

#: ../../../onboarding/fastapi.rst:187
msgid ""
"from litestar import get\n"
"from litestar.params import FromPath, FromQuery\n"
"\n"
"\n"
"@get(\"/{some_path:str}\")\n"
"async def handler(some_path: FromPath[str], some_query: FromQuery[int]) -> "
"None:\n"
"    return None"
msgstr ""

#: ../../../onboarding/fastapi.rst:190
msgid ""
"To define constraints or extend the OpenAPI schema for parameters, use their "
"``Annotated`` shapes :class:`~litestar.params.PathParameter` and :class:"
"`~litestar.params.QueryParameter`:"
msgstr ""

#: ../../../onboarding/fastapi.rst:200
msgid ""
"@app.get(\"/{some_path}\")\n"
"async def handler(\n"
"    some_path: str,\n"
"    some_query: Annotated[int, Query(gt=1)],\n"
") -> None:\n"
"    return None"
msgstr ""

#: ../../../onboarding/fastapi.rst:212
msgid ""
"from typing import Annotated\n"
"\n"
"from litestar import get\n"
"from litestar.params import CookieParameter, HeaderParameter\n"
"\n"
"\n"
"@get(\"/\")\n"
"async def handler(\n"
"    some_cookie: Annotated[int, CookieParameter(lt=10)],\n"
"    some_header: Annotated[int, HeaderParameter(name=\"some-header\", "
"gt=1)],\n"
") -> None:\n"
"    return None"
msgstr ""

#: ../../../onboarding/fastapi.rst:214
msgid "See :doc:`/usage/routing/parameters` for more details."
msgstr ""

#: ../../../onboarding/fastapi.rst:219
msgid "Header and cookie parameters"
msgstr ""

#: ../../../onboarding/fastapi.rst:221
msgid ""
"These take the same shape as :ref:`onboarding/fastapi:Path and query "
"parameters`, with their generic forms :data:`~litestar.params.FromHeader` "
"and :data:`~litestar.params.FromCookie`. One important difference between "
"FastAPI and Litestar is, that FastAPI automatically matches snake case "
"parameter names to cookie / header names (e.g. ``some_header: Annotated[str, "
"Header()]`` will match the header ``Some-Header``). Litestar requires "
"specifying the name explicitly if it does not match the function parameter "
"name."
msgstr ""

#: ../../../onboarding/fastapi.rst:235
msgid ""
"@app.get(\"/\")\n"
"async def handler(\n"
"    some_cookie: Annotated[int, Cookie(lt=10)],\n"
"    some_header: Annotated[int, Header(gt=1)],\n"
") -> None:\n"
"    return None"
msgstr ""

#: ../../../onboarding/fastapi.rst:247
msgid ""
"from typing import Annotated\n"
"\n"
"from litestar import get\n"
"from litestar.params import PathParameter, QueryParameter\n"
"\n"
"\n"
"@get(\"/{some_path:str}\")\n"
"async def handler(\n"
"    some_path: Annotated[str, PathParameter(description=\"This is the path "
"parameter\")],\n"
"    some_query: Annotated[int, QueryParameter(gt=1)],\n"
") -> None:\n"
"    return None"
msgstr ""

#: ../../../onboarding/fastapi.rst:251
msgid "JSON request body"
msgstr ""

#: ../../../onboarding/fastapi.rst:253
msgid ""
"The JSON body binds is injected into the handler via the ``data`` parameter. "
"Its type can be any type supported by Litestar or a validation extension. "
"The data will be validated against this type before it is passed to the "
"handler."
msgstr ""

#: ../../../onboarding/fastapi.rst:257
msgid ""
"Litestar natively supports builtin types, dataclasses, Pydantic models, "
"msgspec ``Struct``\\ s and attrs classes."
msgstr ""

#: ../../../onboarding/fastapi.rst:266
msgid ""
"class Item(BaseModel):\n"
"    name: str\n"
"\n"
"@app.post(\"/items/\")\n"
"async def create_item(item: Item) -> dict[str, str]:\n"
"    return {\"name\": item.name}"
msgstr ""

#: ../../../onboarding/fastapi.rst:278
msgid ""
"from pydantic import BaseModel\n"
"\n"
"from litestar import Litestar, post\n"
"\n"
"\n"
"class Item(BaseModel):\n"
"    name: str\n"
"\n"
"\n"
"@post(\"/items/\")\n"
"async def create_item(data: Item) -> dict[str, str]:\n"
"    return {\"name\": data.name}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[create_item])"
msgstr ""

#: ../../../onboarding/fastapi.rst:282 ../../../onboarding/fastapi.rst:878
msgid "Form data"
msgstr ""

#: ../../../onboarding/fastapi.rst:284
msgid ""
"Form-encoded bodies use the same ``data`` parameter, annotated with :func:"
"`~litestar.params.Body` and a ``media_type`` of :class:`RequestEncodingType."
"URL_ENCODED <litestar.enums.RequestEncodingType>` or :class:"
"`RequestEncodingType.MULTI_PART <litestar.enums.RequestEncodingType>`"
msgstr ""

#: ../../../onboarding/fastapi.rst:289
msgid "One ``data`` declaration replaces FastAPI's per-field ``Form()`` calls."
msgstr ""

#: ../../../onboarding/fastapi.rst:297
msgid ""
"from fastapi import Form\n"
"\n"
"@app.post(\"/login\")\n"
"async def login(\n"
"    username: str = Form(...),\n"
"    password: str = Form(...),\n"
") -> dict[str, str]:\n"
"    return {\"user\": username}"
msgstr ""

#: ../../../onboarding/fastapi.rst:311
msgid ""
"from typing import Annotated\n"
"\n"
"from litestar import Litestar, post\n"
"from litestar.enums import RequestEncodingType\n"
"from litestar.params import Body\n"
"\n"
"\n"
"@post(\"/login\")\n"
"async def login(\n"
"    data: Annotated[dict[str, str], Body(media_type=RequestEncodingType."
"URL_ENCODED)],\n"
") -> dict[str, str]:\n"
"    return {\"user\": data[\"username\"]}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[login])"
msgstr ""

#: ../../../onboarding/fastapi.rst:315
msgid "File uploads"
msgstr ""

#: ../../../onboarding/fastapi.rst:317
msgid ""
"Multipart bodies use the same ``data`` parameter with ``media_type`` set to :"
"class:`RequestEncodingType.MULTI_PART <litestar.enums.RequestEncodingType>`. "
"Uploaded files arrive as :class:`~litestar.datastructures.UploadFile` "
"instances. To receive multiple files, you can simply use "
"``list[UploadFile]``. For mixed form data (i.e. plain fields + uploads), you "
"can simply annotate any field of a supported model type with ``UploadData``."
msgstr ""

#: ../../../onboarding/fastapi.rst:330
msgid ""
"from fastapi import UploadFile\n"
"\n"
"@app.post(\"/upload/\")\n"
"async def upload(files: list[UploadFile]) -> dict[str, list[str]]:\n"
"    return {\"file_names\": [f.filename for f in files]}"
msgstr ""

#: ../../../onboarding/fastapi.rst:341
msgid ""
"from typing import Annotated\n"
"\n"
"from litestar import Litestar, post\n"
"from litestar.datastructures import UploadFile\n"
"from litestar.enums import RequestEncodingType\n"
"from litestar.params import Body\n"
"\n"
"\n"
"@post(\"/upload/\")\n"
"async def upload_file(\n"
"    data: Annotated[list[UploadFile], Body(media_type=RequestEncodingType."
"MULTI_PART)],\n"
") -> dict[str, list[str | None]]:\n"
"    return {\"file_names\": [file.filename for file in data]}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[upload_file])"
msgstr ""

#: ../../../onboarding/fastapi.rst:345
msgid "Synchronous handlers"
msgstr ""

#: ../../../onboarding/fastapi.rst:347
msgid ""
"FastAPI inspects the handler at registration and runs synchronous callables "
"on a threadpool. Litestar has the same mechanism, but it must be explicitly "
"enabled by setting ``sync_to_thread=True``. A synchronous handler without "
"``sync_to_thread`` will emit a warning at startup. If you intentionally do "
"not want to run a synchronous handler inside a thread pool, set "
"``sync_to_thread=False``."
msgstr ""

#: ../../../onboarding/fastapi.rst:359
msgid ""
"@app.get(\"/\")\n"
"def slow_handler() -> dict[str, str]:\n"
"    # implicitly run in a threadpool\n"
"    return {\"hello\": \"world\"}"
msgstr ""

#: ../../../onboarding/fastapi.rst:369
msgid ""
"import time\n"
"\n"
"from litestar import Litestar, get\n"
"\n"
"\n"
"@get(\"/\", sync_to_thread=True)\n"
"def slow_handler() -> dict[str, str]:\n"
"    time.sleep(0.01)\n"
"    return {\"hello\": \"world\"}\n"
"\n"
"\n"
"@get(\"/fast\", sync_to_thread=False)\n"
"def fast_handler() -> dict[str, str]:\n"
"    return {\"hello\": \"world\"}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[slow_handler, fast_handler])"
msgstr ""

#: ../../../onboarding/fastapi.rst:374
msgid "Producing responses"
msgstr ""

#: ../../../onboarding/fastapi.rst:377
msgid "Default status codes"
msgstr ""

#: ../../../onboarding/fastapi.rst:379
msgid ""
"FastAPI returns ``200`` for every method by default. Litestar picks the "
"status code from the HTTP method: ``POST`` defaults to ``201 Created``, "
"``DELETE`` to ``204 No Content``, and everything else to ``200``. You can "
"pass ``status_code=`` to the handler to override the default status code."
msgstr ""

#: ../../../onboarding/fastapi.rst:385
msgid "Cookies and headers"
msgstr ""

#: ../../../onboarding/fastapi.rst:387
msgid ""
"FastAPI defaults to setting headers directly on a ``Response`` . Litestar "
"offers two paths: declare static values on the decorator with "
"``response_cookies`` and ``response_headers``, or return a :class:`~litestar."
"response.Response` with ``cookies=`` and ``headers=`` when the values depend "
"on the request."
msgstr ""

#: ../../../onboarding/fastapi.rst:398
msgid ""
"from fastapi import Response\n"
"\n"
"@app.get(\"/\")\n"
"async def index(response: Response) -> dict[str, str]:\n"
"    response.set_cookie(key=\"my-cookie\", value=\"cookie-value\")\n"
"    return {}"
msgstr ""

#: ../../../onboarding/fastapi.rst:410
msgid ""
"from litestar import Litestar, get\n"
"from litestar.datastructures import Cookie\n"
"\n"
"\n"
"@get(\"/\", response_cookies=[Cookie(key=\"my-cookie\", value=\"cookie-"
"value\")])\n"
"async def handler() -> str:\n"
"    return \"hello\"\n"
"\n"
"\n"
"app = Litestar(route_handlers=[handler])"
msgstr ""

#: ../../../onboarding/fastapi.rst:414
msgid ""
":ref:`Responses - Setting Response Cookies <usage/responses:setting response "
"cookies>`"
msgstr ""

#: ../../../onboarding/fastapi.rst:418
msgid "Serialization"
msgstr ""

#: ../../../onboarding/fastapi.rst:420
msgid ""
"The handler's return annotation drives serialization. Structured types "
"serialise to JSON; ``str`` returns ``text/plain``; a typed response "
"(``Stream``, ``Template``, ``Redirect``, ``File``) picks its own media type. "
"``media_type=`` on the decorator overrides the default."
msgstr ""

#: ../../../onboarding/fastapi.rst:427 ../../../onboarding/fastapi.rst:888
msgid "Templates"
msgstr ""

#: ../../../onboarding/fastapi.rst:429
msgid ""
"FastAPI renders templates through Starlette's ``Jinja2Templates`` helper and "
"returns a ``TemplateResponse``. In Litestar the engine is configured once on "
"the application through :class:`~litestar.template.config.TemplateConfig`, "
"and each handler returns a :class:`~litestar.response.Template`."
msgstr ""

#: ../../../onboarding/fastapi.rst:440
msgid ""
"from fastapi.templating import Jinja2Templates\n"
"\n"
"templates = Jinja2Templates(directory=\"templates\")\n"
"\n"
"@app.get(\"/uploads\")\n"
"async def get_uploads(request: Request):\n"
"    return templates.TemplateResponse(\n"
"        \"uploads.html\", {\"request\": request, \"debug\": True}\n"
"    )"
msgstr ""

#: ../../../onboarding/fastapi.rst:455
msgid ""
"from pathlib import Path\n"
"\n"
"from litestar import Litestar, get\n"
"from litestar.plugins.jinja import JinjaTemplateEngine\n"
"from litestar.response import Template\n"
"from litestar.template.config import TemplateConfig\n"
"\n"
"\n"
"@get(\"/uploads\")\n"
"async def get_uploads() -> Template:\n"
"    return Template(\n"
"        template_str=\"<p>debug={{ debug }}</p>\",\n"
"        context={\"debug\": True},\n"
"    )\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[get_uploads],\n"
"    template_config=TemplateConfig(\n"
"        directory=Path(__file__).parent,\n"
"        engine=JinjaTemplateEngine,\n"
"    ),\n"
")"
msgstr ""

#: ../../../onboarding/fastapi.rst:459
msgid ":doc:`/usage/templating`"
msgstr ""

#: ../../../onboarding/fastapi.rst:463
msgid "Streaming responses"
msgstr ""

#: ../../../onboarding/fastapi.rst:465
msgid ""
"FastAPI uses ``StreamingResponse``; Litestar uses :class:`~litestar.response."
"Stream`. Both wrap a sync or async iterator."
msgstr ""

#: ../../../onboarding/fastapi.rst:474
msgid ""
"from fastapi.responses import StreamingResponse\n"
"\n"
"@app.get(\"/numbers\")\n"
"async def stream_numbers() -> StreamingResponse:\n"
"    async def numbers():\n"
"        for i in range(5):\n"
"            yield f\"{i}\\n\".encode()\n"
"\n"
"    return StreamingResponse(numbers())"
msgstr ""

#: ../../../onboarding/fastapi.rst:489
msgid ""
"from collections.abc import AsyncIterator\n"
"\n"
"from litestar import Litestar, get\n"
"from litestar.response import Stream\n"
"\n"
"\n"
"async def numbers() -> AsyncIterator[bytes]:\n"
"    for i in range(5):\n"
"        yield f\"{i}\\n\".encode()\n"
"\n"
"\n"
"@get(\"/numbers\")\n"
"async def stream_numbers() -> Stream:\n"
"    return Stream(numbers())\n"
"\n"
"\n"
"app = Litestar(route_handlers=[stream_numbers])"
msgstr ""

#: ../../../onboarding/fastapi.rst:493 ../../../onboarding/fastapi.rst:870
msgid "Dependency injection"
msgstr ""

#: ../../../onboarding/fastapi.rst:495
msgid ""
"FastAPI declares a dependency at the call site, either as a default value or "
"inside the parameter annotation via ``Depends(fn)``, or in a list on the "
"path operation. Litestar declares dependencies as a mapping from parameter "
"name to provider, attached to the ``dependencies`` keyword on any layer. "
"Async callables can be used as dependency providers natively, sync callables "
"must be wrapped in :class:`~litestar.di.Provide`."
msgstr ""

#: ../../../onboarding/fastapi.rst:507
msgid ""
"from fastapi import FastAPI, Depends, APIRouter\n"
"\n"
"async def route_dependency() -> bool: ...\n"
"async def nested_dependency() -> str: ...\n"
"async def router_dependency() -> int: ...\n"
"async def app_dependency(data: str = Depends(nested_dependency)) -> "
"int: ...\n"
"\n"
"router = APIRouter(dependencies=[Depends(router_dependency)])\n"
"app = FastAPI(dependencies=[Depends(nested_dependency)])\n"
"app.include_router(router)\n"
"\n"
"@app.get(\"/\")\n"
"async def handler(\n"
"    val_route: bool = Depends(route_dependency),\n"
"    val_router: int = Depends(router_dependency),\n"
"    val_nested: str = Depends(nested_dependency),\n"
"    val_app: int = Depends(app_dependency),\n"
") -> None: ..."
msgstr ""

#: ../../../onboarding/fastapi.rst:531
msgid ""
"from litestar import Litestar, Router, get\n"
"from litestar.di import NamedDependency\n"
"\n"
"\n"
"async def route_dependency() -> bool:\n"
"    return True\n"
"\n"
"\n"
"async def nested_dependency() -> str:\n"
"    return \"nested\"\n"
"\n"
"\n"
"async def router_dependency() -> int:\n"
"    return 1\n"
"\n"
"\n"
"async def app_dependency(val_nested: NamedDependency[str]) -> int:\n"
"    return len(val_nested)\n"
"\n"
"\n"
"@get(\"/\", dependencies={\"val_route\": route_dependency})\n"
"async def handler(\n"
"    val_route: NamedDependency[bool],\n"
"    val_router: NamedDependency[int],\n"
"    val_nested: NamedDependency[str],\n"
"    val_app: NamedDependency[int],\n"
") -> dict[str, object]:\n"
"    return {\n"
"        \"val_route\": val_route,\n"
"        \"val_router\": val_router,\n"
"        \"val_nested\": val_nested,\n"
"        \"val_app\": val_app,\n"
"    }\n"
"\n"
"\n"
"router = Router(\n"
"    path=\"/\",\n"
"    route_handlers=[handler],\n"
"    dependencies={\"val_router\": router_dependency},\n"
")\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[router],\n"
"    dependencies={\n"
"        \"val_app\": app_dependency,\n"
"        \"val_nested\": nested_dependency,\n"
"    },\n"
")"
msgstr ""

#: ../../../onboarding/fastapi.rst:535
msgid ""
"As most configuration in Litestar, dependencies are layered. Inner layers "
"override outer ones, so a router-scoped dependency replaces an application-"
"scoped one of the same name, and a handler-scoped one replaces both."
msgstr ""

