#: ../../../onboarding/django.rst:1283 ../../../onboarding/django.rst:1616
msgid "Sessions"
msgstr ""

#: ../../../onboarding/django.rst:1285
msgid ""
"Django's ``django.contrib.sessions`` writes a session cookie and stores data "
"in a configurable backend (database, cache, file, or signed cookie). "
"Litestar's :class:`~litestar.middleware.session.server_side."
"ServerSideSessionConfig` writes the session through a pluggable :class:"
"`~litestar.stores.base.Store` (memory, file, redis, valkey); :class:"
"`~litestar.middleware.session.client_side.CookieBackendConfig` keeps the "
"data in a signed cookie. The middleware exposes ``request.session`` as a "
"dict."
msgstr ""

#: ../../../onboarding/django.rst:1299
msgid ""
"def login(request):\n"
"    request.session[\"user\"] = \"alice\"\n"
"\n"
"def whoami(request):\n"
"    return JsonResponse({\"user\": request.session.get(\"user\")})"
msgstr ""

#: ../../../onboarding/django.rst:1310
msgid ""
"from typing import Any\n"
"\n"
"from litestar import Litestar, Request, get, post\n"
"from litestar.middleware.session.server_side import ServerSideSessionConfig\n"
"\n"
"session_config = ServerSideSessionConfig()\n"
"\n"
"\n"
"@post(\"/login\", sync_to_thread=False)\n"
"def login(request: Request) -> None:\n"
"    request.set_session({\"user\": \"alice\"})\n"
"\n"
"\n"
"@get(\"/whoami\", sync_to_thread=False)\n"
"def whoami(request: Request) -> dict[str, Any]:\n"
"    return {\"user\": request.session.get(\"user\")}\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[login, whoami],\n"
"    middleware=[session_config.middleware],\n"
")"
msgstr ""

#: ../../../onboarding/django.rst:1314 ../../../onboarding/django.rst:1618
msgid "Static files"
msgstr ""

#: ../../../onboarding/django.rst:1316
msgid ""
"Django needs ``django.contrib.staticfiles`` in ``INSTALLED_APPS``, a "
"``STATICFILES_DIRS`` setting, and a ``collectstatic`` step before "
"deployment. Litestar registers a static-file router through :func:`~litestar."
"static_files.create_static_files_router`. The same configuration serves "
"files in development and production; there is no separate collection step."
msgstr ""

#: ../../../onboarding/django.rst:1328
msgid ""
"# settings.py\n"
"STATIC_URL = \"/static/\"\n"
"STATICFILES_DIRS = [BASE_DIR / \"assets\"]"
msgstr ""

#: ../../../onboarding/django.rst:1337
msgid ""
"from pathlib import Path\n"
"\n"
"from litestar import Litestar\n"
"from litestar.static_files import create_static_files_router\n"
"\n"
"ASSETS_DIR = Path(__file__).parent / \"assets\"\n"
"\n"
"\n"
"def ensure_assets() -> None:\n"
"    ASSETS_DIR.mkdir(exist_ok=True)\n"
"    ASSETS_DIR.joinpath(\"hello.txt\").write_text(\"Hello, world!\")\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[\n"
"        create_static_files_router(path=\"/static\", "
"directories=[ASSETS_DIR]),\n"
"    ],\n"
"    on_startup=[ensure_assets],\n"
")"
msgstr ""

#: ../../../onboarding/django.rst:1341
msgid "WebSockets and channels"
msgstr ""

#: ../../../onboarding/django.rst:1343
msgid ""
"Django has no first-party WebSocket support; Django Channels adds an ASGI "
"worker, a routing system, consumer classes, and a ``channel_layer`` for pub/"
"sub. Litestar offers WebSockets as a built-in primitive. There are three "
"handler styles:"
msgstr ""

#: ../../../onboarding/django.rst:1347
msgid ""
":func:`~litestar.handlers.websocket`: raw `ASGI WebSocket <https://asgi."
"readthedocs.io/en/latest/specs/www.html#websocket>`_ handling; same "
"semantics as a Channels ``AsyncWebsocketConsumer``."
msgstr ""

#: ../../../onboarding/django.rst:1350
msgid ""
":func:`~litestar.handlers.websocket_listener`: per-message callback that "
"takes and returns typed values; the framework handles accept, the receive "
"loop, and serialisation."
msgstr ""

#: ../../../onboarding/django.rst:1353
msgid ""
":func:`~litestar.handlers.websocket_stream`: async generator that pushes "
"messages to the WebSocket; the framework handles accept, the receive loop, "
"and serialisation."
msgstr ""

#: ../../../onboarding/django.rst:0
msgid "Django Channels"
msgstr ""

#: ../../../onboarding/django.rst:1363
msgid ""
"from channels.generic.websocket import AsyncJsonWebsocketConsumer\n"
"\n"
"class EchoConsumer(AsyncJsonWebsocketConsumer):\n"
"    async def connect(self):\n"
"        await self.accept()\n"
"\n"
"    async def receive_json(self, content):\n"
"        await self.send_json({\"echo\": content[\"message\"]})"
msgstr ""

#: ../../../onboarding/django.rst:1377
msgid ""
"from litestar import Litestar, websocket_listener\n"
"\n"
"\n"
"@websocket_listener(\"/ws\")\n"
"async def echo(data: dict[str, str]) -> dict[str, str]:\n"
"    return {\"echo\": data[\"message\"]}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[echo])"
msgstr ""

#: ../../../onboarding/django.rst:1379
msgid ""
"For broadcast and pub/sub patterns (the ``channel_layer.group_send`` case) "
"Litestar provides the :doc:`channels </usage/channels>` plugin. It handles "
"per-channel subscriptions, message history, and inter-process fan-out "
"through a pluggable backend (memory, redis, asyncpg, psycopg), and can "
"generate WebSocket route handlers that publish incoming events to subscribed "
"clients."
msgstr ""

#: ../../../onboarding/django.rst:1391
msgid ""
"from litestar import Litestar\n"
"from litestar.channels import ChannelsPlugin\n"
"from litestar.channels.backends.memory import MemoryChannelsBackend\n"
"\n"
"channels_plugin = ChannelsPlugin(\n"
"    backend=MemoryChannelsBackend(),\n"
"    channels=[\"chat\"],\n"
"    create_ws_route_handlers=True,\n"
")\n"
"\n"
"app = Litestar(plugins=[channels_plugin])"
msgstr ""

