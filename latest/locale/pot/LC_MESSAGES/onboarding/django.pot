#: ../../../onboarding/django.rst:558
msgid "Producing responses"
msgstr ""

#: ../../../onboarding/django.rst:560
msgid ""
"Django returns ``HttpResponse``, ``JsonResponse``, ``HttpResponseRedirect`` "
"and so on, with status and headers set explicitly. DRF wraps the body in "
"``Response(data, status=...)`` and renders through the configured renderer. "
"Litestar infers the response from the handler's return annotation; a "
"returned dict, dataclass, or model serialises to JSON, ``str`` returns "
"``text/plain``, and typed response classes (:class:`~litestar.response."
"Response`, :class:`~litestar.response.Stream`, :class:`~litestar.response."
"Template`, :class:`~litestar.response.Redirect`, :class:`~litestar.response."
"File`) pick their own media type."
msgstr ""

#: ../../../onboarding/django.rst:571
msgid "Default status codes"
msgstr ""

#: ../../../onboarding/django.rst:573
msgid ""
"Django defaults to ``200`` for every method; DRF defaults to ``200`` unless "
"``status=`` is passed. Litestar picks the default from the HTTP method: "
"``POST`` defaults to ``201 Created``, ``DELETE`` to ``204 No Content``, and "
"everything else to ``200``. Pass ``status_code=`` to the decorator to "
"override."
msgstr ""

#: ../../../onboarding/django.rst:580
msgid "Cookies and headers"
msgstr ""

#: ../../../onboarding/django.rst:582
msgid ""
"Django sets cookies and headers on the response object (``response."
"set_cookie(...)``, ``response[\"X-Foo\"] = \"bar\"``). DRF works the same. "
"Litestar offers two paths: declare static values on the decorator with "
"``response_cookies=`` and ``response_headers=``, or return a :class:"
"`~litestar.response.Response` with ``cookies=`` and ``headers=`` when the "
"values depend on the request."
msgstr ""

#: ../../../onboarding/django.rst:590
msgid ""
"Setting a static response header or cookie will automatically render it in "
"the OpenAPI schema"
msgstr ""

#: ../../../onboarding/django.rst:599
msgid ""
"def view(request):\n"
"    response = JsonResponse({\"set\": \"dynamic\"})\n"
"    response.set_cookie(\"my-cookie\", \"cookie-value\")\n"
"    return response"
msgstr ""

#: ../../../onboarding/django.rst:609
msgid ""
"from litestar import Litestar, Response, get\n"
"from litestar.datastructures import Cookie\n"
"\n"
"\n"
"@get(\"/static\", response_cookies=[Cookie(key=\"my-cookie\", value=\"cookie-"
"value\")])\n"
"async def static_cookie() -> dict[str, str]:\n"
"    return {\"set\": \"static\"}\n"
"\n"
"\n"
"@get(\"/dynamic\")\n"
"async def dynamic_cookie() -> Response[dict[str, str]]:\n"
"    return Response(\n"
"        {\"set\": \"dynamic\"},\n"
"        cookies=[Cookie(key=\"my-cookie\", value=\"cookie-value\")],\n"
"    )\n"
"\n"
"\n"
"app = Litestar(route_handlers=[static_cookie, dynamic_cookie])"
msgstr ""

#: ../../../onboarding/django.rst:613
msgid ""
":ref:`Responses - Setting Response Cookies <usage/responses:setting response "
"cookies>`"
msgstr ""

#: ../../../onboarding/django.rst:617
msgid "Serialization"
msgstr ""

#: ../../../onboarding/django.rst:619
msgid ""
"DRF's ``Response(serializer.data)`` round-trips through the configured "
"renderer (JSON by default), with a separate HTML \"browsable API\" renderer "
"for browsers. Litestar drives serialisation off the handler return "
"annotation. Structured types serialise to JSON; ``str`` returns ``text/"
"plain``; a typed response class picks its own media type. ``media_type=`` on "
"the decorator overrides the default."
msgstr ""

#: ../../../onboarding/django.rst:627 ../../../onboarding/django.rst:1590
msgid "Templates"
msgstr ""

#: ../../../onboarding/django.rst:629
msgid ""
"Django's ``render(request, \"template.html\", context)`` and DRF's "
"``TemplateHTMLRenderer`` are the common cases. Litestar configures the "
"engine once on the application through :class:`~litestar.template.config."
"TemplateConfig` and each handler returns a :class:`~litestar.response."
"Template`. The bundled engines are Jinja, Mako, and MiniJinja; the engine "
"slot accepts any implementation of the template-engine protocol."
msgstr ""

#: ../../../onboarding/django.rst:642
msgid ""
"# settings.py\n"
"TEMPLATES = [{\n"
"    \"BACKEND\": \"django.template.backends.django.DjangoTemplates\",\n"
"    \"DIRS\": [BASE_DIR / \"templates\"],\n"
"}]\n"
"\n"
"# views.py\n"
"from django.shortcuts import render\n"
"\n"
"def hello(request, name):\n"
"    return render(request, \"hello.html\", {\"name\": name})"
msgstr ""

#: ../../../onboarding/django.rst:659
msgid ""
"from pathlib import Path\n"
"\n"
"from litestar import Litestar, get\n"
"from litestar.contrib.jinja import JinjaTemplateEngine\n"
"from litestar.params import FromPath\n"
"from litestar.response import Template\n"
"from litestar.template.config import TemplateConfig\n"
"\n"
"\n"
"@get(\"/hello/{name:str}\")\n"
"async def hello(name: FromPath[str]) -> Template:\n"
"    return Template(\n"
"        template_str=\"<p>Hello, {{ name }}!</p>\",\n"
"        context={\"name\": name},\n"
"    )\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[hello],\n"
"    template_config=TemplateConfig(\n"
"        directory=Path(__file__).parent,\n"
"        engine=JinjaTemplateEngine,\n"
"    ),\n"
")"
msgstr ""

#: ../../../onboarding/django.rst:663
msgid ":doc:`/usage/templating`"
msgstr ""

#: ../../../onboarding/django.rst:667
msgid "Streaming responses"
msgstr ""

#: ../../../onboarding/django.rst:669
msgid ""
"Django uses ``StreamingHttpResponse(iterator)``; Litestar uses :class:"
"`~litestar.response.Stream`. Both wrap a sync or async iterator."
msgstr ""

#: ../../../onboarding/django.rst:678
msgid ""
"from django.http import StreamingHttpResponse\n"
"\n"
"def stream_numbers(request):\n"
"    def numbers():\n"
"        for i in range(5):\n"
"            yield f\"{i}\\n\"\n"
"    return StreamingHttpResponse(numbers())"
msgstr ""

#: ../../../onboarding/django.rst:691
msgid ""
"from collections.abc import AsyncIterator\n"
"\n"
"from litestar import Litestar, get\n"
"from litestar.response import Stream\n"
"\n"
"\n"
"async def numbers() -> AsyncIterator[bytes]:\n"
"    for i in range(5):\n"
"        yield f\"{i}\\n\".encode()\n"
"\n"
"\n"
"@get(\"/numbers\")\n"
"async def stream_numbers() -> Stream:\n"
"    return Stream(numbers())\n"
"\n"
"\n"
"app = Litestar(route_handlers=[stream_numbers])"
msgstr ""

#: ../../../onboarding/django.rst:695
msgid "URL lookup"
msgstr ""

#: ../../../onboarding/django.rst:697
msgid ""
"Django's ``reverse(\"view-name\", kwargs=...)`` and the ``{% url %}`` "
"template tag build URLs from named patterns; DRF adds ``reverse(\"api-"
"detail\", request=request)`` to include the absolute URL. Litestar exposes :"
"meth:`~litestar.app.Litestar.route_reverse` on the application and :meth:"
"`~litestar.connection.ASGIConnection.url_for` on the request. Handlers name "
"themselves through ``name=`` on the decorator."
msgstr ""

#: ../../../onboarding/django.rst:710
msgid ""
"# urls.py\n"
"path(\"\", views.index, name=\"index\")\n"
"\n"
"# views.py\n"
"from django.shortcuts import redirect\n"
"from django.urls import reverse\n"
"\n"
"def go_home(request):\n"
"    return redirect(reverse(\"index\"))"
msgstr ""

#: ../../../onboarding/django.rst:725
msgid ""
"from litestar import Litestar, Request, get\n"
"from litestar.params import FromPath\n"
"from litestar.response import Redirect\n"
"\n"
"\n"
"@get(\"/\", name=\"index\")\n"
"async def index() -> dict[str, str]:\n"
"    return {\"page\": \"index\"}\n"
"\n"
"\n"
"@get(\"/{item_id:int}\", name=\"item-detail\")\n"
"async def item_detail(item_id: FromPath[int]) -> dict[str, int]:\n"
"    return {\"id\": item_id}\n"
"\n"
"\n"
"@get(\"/redirect\")\n"
"async def to_index(request: Request) -> Redirect:\n"
"    return Redirect(path=request.url_for(\"index\"))\n"
"\n"
"\n"
"app = Litestar(route_handlers=[index, item_detail, to_index])"
msgstr ""

#: ../../../onboarding/django.rst:729
msgid "Serializers and DTOs"
msgstr ""

#: ../../../onboarding/django.rst:731
msgid ""
"DRF's ``Serializer`` and ``ModelSerializer`` carry three concerns: "
"validating inbound data, rendering outbound data, and mapping between the "
"wire shape and the ORM model. Litestar splits these. Model libraries "
"(dataclasses, msgspec, Pydantic, attrs) handle validation and basic shape, "
"applied through the ``data`` parameter and the return annotation. **DTOs** "
"decouple the wire shape from the internal model when the two should differ: "
"an inbound payload that excludes server-managed fields, a response that "
"renames fields, a partial update that accepts a subset of the model. "
"Litestar ships :class:`~litestar.dto.dataclass_dto.DataclassDTO`, :class:"
"`~litestar.dto.msgspec_dto.MsgspecDTO`, ``PydanticDTO``, and "
"``SQLAlchemyDTO`` (for ORM models)."
msgstr ""

#: ../../../onboarding/django.rst:742
msgid "The basic case: excluding a server-set field from inbound payloads:"
msgstr ""

#: ../../../onboarding/django.rst:750
msgid ""
"class UserSerializer(serializers.ModelSerializer):\n"
"    class Meta:\n"
"        model = User\n"
"        fields = [\"id\", \"name\", \"email\"]\n"
"        read_only_fields = [\"id\"]"
msgstr ""

#: ../../../onboarding/django.rst:761
msgid ""
"from dataclasses import dataclass\n"
"from uuid import UUID, uuid4\n"
"\n"
"from litestar import Litestar, post\n"
"from litestar.dto import DataclassDTO, DTOConfig, DTOData\n"
"\n"
"\n"
"@dataclass\n"
"class User:\n"
"    id: UUID\n"
"    name: str\n"
"    email: str\n"
"\n"
"\n"
"class UserWriteDTO(DataclassDTO[User]):\n"
"    \"\"\"Inbound payloads cannot set the server-managed ``id`` field."
"\"\"\"\n"
"\n"
"    config = DTOConfig(exclude={\"id\"})\n"
"\n"
"\n"
"@post(\"/users\", dto=UserWriteDTO, return_dto=None)\n"
"async def create_user(data: DTOData[User]) -> User:\n"
"    return data.create_instance(id=uuid4())\n"
"\n"
"\n"
"app = Litestar(route_handlers=[create_user])"
msgstr ""

#: ../../../onboarding/django.rst:763
msgid ""
"The :class:`~litestar.dto.data_structures.DTOData` wrapper holds the parsed-"
"and-validated input; ``create_instance(**overrides)`` materialises it into "
"the model with server-managed fields filled in."
msgstr ""

#: ../../../onboarding/django.rst:767
msgid ""
"For ORM-backed models, ``SQLAlchemyDTO`` understands the mapped class and "
"lets the same configuration drive both the inbound and outbound shape. The "
"DTO is attached to the handler through ``dto=`` (for the request body) and "
"``return_dto=`` (for the response):"
msgstr ""

#: ../../../onboarding/django.rst:778
msgid ""
"class ItemSerializer(serializers.ModelSerializer):\n"
"    class Meta:\n"
"        model = Item\n"
"        fields = [\"id\", \"name\", \"price\"]\n"
"        read_only_fields = [\"id\"]\n"
"\n"
"class ItemView(generics.CreateAPIView):\n"
"    serializer_class = ItemSerializer"
msgstr ""

#: ../../../onboarding/django.rst:792
msgid ""
"from typing import Annotated\n"
"\n"
"from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column\n"
"\n"
"from litestar import Litestar, post\n"
"from litestar.dto import DTOConfig\n"
"from litestar.plugins.sqlalchemy import SQLAlchemyDTO\n"
"\n"
"\n"
"class Base(DeclarativeBase):\n"
"    pass\n"
"\n"
"\n"
"class Item(Base):\n"
"    __tablename__ = \"items\"\n"
"    id: Mapped[int] = mapped_column(primary_key=True)\n"
"    name: Mapped[str]\n"
"    price: Mapped[float]\n"
"\n"
"\n"
"WriteItemDTO = SQLAlchemyDTO[Annotated[Item, DTOConfig(exclude={\"id\"})]]\n"
"ReadItemDTO = SQLAlchemyDTO[Item]\n"
"\n"
"\n"
"@post(\"/items\", dto=WriteItemDTO, return_dto=ReadItemDTO)\n"
"async def create_item(data: Item) -> Item:\n"
"    data.id = 1\n"
"    return data\n"
"\n"
"\n"
"app = Litestar(route_handlers=[create_item])"
msgstr ""

#: ../../../onboarding/django.rst:794
msgid ""
"DRF's ``partial=True`` on the serializer is mirrored by "
"``DTOConfig(partial=True)`` on a write DTO: optional fields become "
"permitted, required fields become optional."
msgstr ""

#: ../../../onboarding/django.rst:798
msgid ""
"The same shape used for input is rarely the right shape for output; the DTO "
"lets one model definition produce both, with the differences declared as "
"configuration rather than written twice."
msgstr ""

#: ../../../onboarding/django.rst:802
msgid "info"
msgstr ""

#: ../../../onboarding/django.rst:804
msgid ""
"DTOs also serve as the adapter for types Litestar would not otherwise know "
"how to serialise, and do not offer serialization methods by themselves; A "
"SQLAlchemy ``DeclarativeBase`` subclass is not a dataclass and has no "
"msgspec or Pydantic schema, but ``SQLAlchemyDTO`` reads the mapped columns "
"and produces a wire schema from them, by representing the model as an "
"abstract shape Litestar *can* understand. The same pattern extends to other "
"libraries: any DTO subclass that understands a model type can adopt it. This "
"is how Litestar stays modelling-library-agnostic while still letting you "
"return an ORM instance directly from a handler."
msgstr ""

#: ../../../onboarding/django.rst:816 ../../../onboarding/django.rst:1545
msgid ":doc:`/usage/dto/index`"
msgstr ""

#: ../../../onboarding/django.rst:820
msgid "Dependency injection"
msgstr ""

#: ../../../onboarding/django.rst:822
msgid ""
"DRF threads request-scoped state through ``self.request``, ``self.kwargs``, "
"and ``self.get_serializer_context()``; everything else (database clients, "
"service classes, configuration) is typically reached through module-level "
"imports. Litestar has a first-class dependency-injection container. "
"Dependencies are declared as a mapping from parameter name to provider, "
"attached to the ``dependencies`` keyword on any layer. Async callables work "
"directly as providers; synchronous callables are wrapped in :class:"
"`~litestar.di.Provide`."
msgstr ""

#: ../../../onboarding/django.rst:830
msgid ""
"Inner layers override outer ones, so a router-scoped dependency replaces an "
"application-scoped one of the same name, and a handler-scoped one replaces "
"both."
msgstr ""

#: ../../../onboarding/django.rst:839
msgid ""
"# services.py\n"
"payments = PaymentService()\n"
"\n"
"# views.py\n"
"from .services import payments\n"
"\n"
"class ChargeView(APIView):\n"
"    def get(self, request):\n"
"        user_id = request.user.id\n"
"        return Response({\"user_id\": user_id, \"result\": payments."
"charge(100)})"
msgstr ""

#: ../../../onboarding/django.rst:855
msgid ""
"from typing import Dict\n"
"\n"
"from litestar import Litestar, Router, get\n"
"from litestar.di import NamedDependency\n"
"\n"
"\n"
"class PaymentService:\n"
"    def charge(self, amount: int) -> str:\n"
"        return f\"charged {amount}\"\n"
"\n"
"\n"
"async def provide_payments() -> PaymentService:\n"
"    return PaymentService()\n"
"\n"
"\n"
"async def provide_current_user_id() -> int:\n"
"    return 42\n"
"\n"
"\n"
"@get(\"/charge\")\n"
"async def charge_handler(payments: NamedDependency[PaymentService], user_id: "
"int) -> Dict[str, object]:\n"
"    return {\"user_id\": user_id, \"result\": payments.charge(100)}\n"
"\n"
"\n"
"router = Router(\n"
"    path=\"/api\",\n"
"    route_handlers=[charge_handler],\n"
"    dependencies={\"user_id\": provide_current_user_id},\n"
")\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[router],\n"
"    dependencies={\"payments\": provide_payments},\n"
")"
msgstr ""

#: ../../../onboarding/django.rst:855
msgid ""
"from litestar import Litestar, Router, get\n"
"from litestar.di import NamedDependency\n"
"\n"
"\n"
"class PaymentService:\n"
"    def charge(self, amount: int) -> str:\n"
"        return f\"charged {amount}\"\n"
"\n"
"\n"
"async def provide_payments() -> PaymentService:\n"
"    return PaymentService()\n"
"\n"
"\n"
"async def provide_current_user_id() -> int:\n"
"    return 42\n"
"\n"
"\n"
"@get(\"/charge\")\n"
"async def charge_handler(payments: NamedDependency[PaymentService], user_id: "
"int) -> dict[str, object]:\n"
"    return {\"user_id\": user_id, \"result\": payments.charge(100)}\n"
"\n"
"\n"
"router = Router(\n"
"    path=\"/api\",\n"
"    route_handlers=[charge_handler],\n"
"    dependencies={\"user_id\": provide_current_user_id},\n"
")\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[router],\n"
"    dependencies={\"payments\": provide_payments},\n"
")"
msgstr ""

#: ../../../onboarding/django.rst:858
msgid ""
"Dependencies are part of Litestar's layered architecture, so these can be "
"declared on applications, routers, controllers or route handlers."
msgstr ""

#: ../../../onboarding/django.rst:863
msgid ":doc:`/usage/dependency-injection`"
msgstr ""

#: ../../../onboarding/django.rst:867
msgid "Exceptions and error responses"
msgstr ""

#: ../../../onboarding/django.rst:869
msgid ""
"Django raises ``Http404``, ``PermissionDenied``, and "
"``SuspiciousOperation``; DRF adds ``APIException``, ``NotFound``, "
"``ValidationError``, ``PermissionDenied``, and the ``EXCEPTION_HANDLER`` "
"setting that maps them to JSON responses. Litestar exports :class:`~litestar."
"exceptions.HTTPException` and concrete subclasses (:class:`~litestar."
"exceptions.NotFoundException`, :class:`~litestar.exceptions."
"PermissionDeniedException`, :class:`~litestar.exceptions."
"ValidationException`, :class:`~litestar.exceptions.NotAuthorizedException`). "
"The status code is a keyword argument (``status_code=``), and a positional "
"argument to ``HTTPException`` is appended to ``detail``."
msgstr ""

#: ../../../onboarding/django.rst:886
msgid ""
"from rest_framework.exceptions import NotFound\n"
"\n"
"class ItemView(APIView):\n"
"    def get(self, request, item_id):\n"
"        if item_id != 1:\n"
"            raise NotFound(detail=f\"item {item_id} does not exist\")\n"
"        return Response({\"id\": item_id})"
msgstr ""

#: ../../../onboarding/django.rst:899
msgid ""
"from litestar import Litestar, get\n"
"from litestar.exceptions import NotFoundException\n"
"from litestar.params import FromPath\n"
"\n"
"\n"
"@get(\"/items/{item_id:int}\")\n"
"async def get_item(item_id: FromPath[int]) -> dict[str, int]:\n"
"    if item_id != 1:\n"
"        raise NotFoundException(detail=f\"item {item_id} does not exist\")\n"
"    return {\"id\": item_id}\n"
"\n"
"\n"
"app = Litestar(route_handlers=[get_item])"
msgstr ""

#: ../../../onboarding/django.rst:903
msgid "Custom exception handlers"
msgstr ""

#: ../../../onboarding/django.rst:905
msgid ""
"DRF replaces the global exception handler through the ``EXCEPTION_HANDLER`` "
"setting that points to a single callable. Django's ``handler404`` and "
"``handler500`` project-level variables point to views for two status codes. "
"Litestar accepts a mapping from exception class or status code to a handler "
"callable through ``exception_handlers={...}`` on any layer."
msgstr ""

#: ../../../onboarding/django.rst:912
msgid ""
"Exception handling is part of Litestar's layered architecture, so these can "
"be declared on applications, routers, controllers or route handlers."
msgstr ""

#: ../../../onboarding/django.rst:921
msgid ""
"# settings.py\n"
"REST_FRAMEWORK = {\"EXCEPTION_HANDLER\": \"myapp.exceptions.handler\"}\n"
"\n"
"# exceptions.py\n"
"from rest_framework.views import exception_handler\n"
"\n"
"def handler(exc, context):\n"
"    if isinstance(exc, ItemNotFoundError):\n"
"        return Response({\"detail\": \"item not found\"}, status=404)\n"
"    return exception_handler(exc, context)"
msgstr ""

#: ../../../onboarding/django.rst:937
msgid ""
"from litestar import Litestar, Request, Response, get\n"
"\n"
"\n"
"class ItemNotFoundError(Exception):\n"
"    pass\n"
"\n"
"\n"
"def handle_item_not_found(request: Request, exception: ItemNotFoundError) -> "
"Response[dict[str, str]]:\n"
"    return Response({\"detail\": \"item not found\"}, status_code=404)\n"
"\n"
"\n"
"@get(\"/\")\n"
"async def index() -> None:\n"
"    raise ItemNotFoundError\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[index],\n"
"    exception_handlers={ItemNotFoundError: handle_item_not_found},\n"
")"
