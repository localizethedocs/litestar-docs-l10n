#: ../../../onboarding/django.rst:1400
msgid "Rate limiting"
msgstr ""

#: ../../../onboarding/django.rst:1402
msgid ""
"DRF's ``throttle_classes`` (``UserRateThrottle``, ``AnonRateThrottle``, "
"``ScopedRateThrottle``) limits per user, IP, or named scope through a cache "
"backend. Litestar's :class:`~litestar.middleware.rate_limit.RateLimitConfig` "
"installs :class:`~litestar.middleware.rate_limit.RateLimitMiddleware` with a "
"pluggable store."
msgstr ""

#: ../../../onboarding/django.rst:1413
msgid ""
"# settings.py\n"
"REST_FRAMEWORK = {\n"
"    \"DEFAULT_THROTTLE_CLASSES\": [\"rest_framework.throttling."
"UserRateThrottle\"],\n"
"    \"DEFAULT_THROTTLE_RATES\": {\"user\": \"60/minute\"},\n"
"}"
msgstr ""

#: ../../../onboarding/django.rst:1424
msgid ""
"from litestar import Litestar, MediaType, get\n"
"from litestar.middleware.rate_limit import RateLimitConfig\n"
"\n"
"rate_limit_config = RateLimitConfig(rate_limit=(\"minute\", 60), exclude=[\"/"
"schema\"])\n"
"\n"
"\n"
"@get(\"/\", media_type=MediaType.TEXT)\n"
"async def handler() -> str:\n"
"    return \"ok\"\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[handler],\n"
"    middleware=[rate_limit_config.middleware],\n"
")"
msgstr ""

#: ../../../onboarding/django.rst:1428
msgid "Testing"
msgstr ""

#: ../../../onboarding/django.rst:1430
msgid ""
"Django's ``TestCase`` + ``Client`` and DRF's ``APITestCase`` + ``APIClient`` "
"send requests to the WSGI app in-process. Litestar ships :class:`~litestar."
"testing.TestClient` (sync) and :class:`~litestar.testing.AsyncTestClient` "
"(async), both built on ``httpx``. For unit-level handler tests, :func:"
"`~litestar.testing.create_test_client` and :func:`~litestar.testing."
"create_async_test_client` take the same arguments as :class:`Litestar` and "
"return a configured client."
msgstr ""

#: ../../../onboarding/django.rst:1444
msgid ""
"from rest_framework.test import APITestCase\n"
"\n"
"class HelloTests(APITestCase):\n"
"    def test_index(self):\n"
"        response = self.client.get(\"/\")\n"
"        self.assertEqual(response.status_code, 200)\n"
"        self.assertEqual(response.json(), {\"hello\": \"world\"})"
msgstr ""

#: ../../../onboarding/django.rst:1457
msgid ""
"from typing import Dict\n"
"\n"
"from litestar import get\n"
"from litestar.status_codes import HTTP_200_OK\n"
"from litestar.testing import create_test_client\n"
"\n"
"\n"
"@get(\"/\")\n"
"async def hello() -> Dict[str, str]:\n"
"    return {\"hello\": \"world\"}\n"
"\n"
"\n"
"def test_hello() -> None:\n"
"    with create_test_client(route_handlers=[hello]) as client:\n"
"        response = client.get(\"/\")\n"
"    assert response.status_code == HTTP_200_OK\n"
"    assert response.json() == {\"hello\": \"world\"}"
msgstr ""

#: ../../../onboarding/django.rst:1457
