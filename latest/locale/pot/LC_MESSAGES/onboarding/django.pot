#: ../../../onboarding/django.rst:1101
msgid ""
"Django middleware applies to every request that enters the WSGI / ASGI "
"stack; opting routes out means restructuring the middleware itself or "
"splitting URL patterns. Litestar middleware can be excluded per route, in "
"two ways:"
msgstr ""

#: ../../../onboarding/django.rst:1105
msgid ""
"By setting ``scopes`` on the middleware, it can restricted to ``http`` or "
"``websocket`` requests"
msgstr ""

#: ../../../onboarding/django.rst:1106
msgid ""
"By setting ``exclude_path_pattern`` on the middleware, it can be excluded "
"from any handler matching"
msgstr ""

#: ../../../onboarding/django.rst:1107
msgid ""
"``exclude_opt_key`` names a key in the handler's ``opt`` dict; handlers that "
"set that key to a truthy value skip the middleware"
msgstr ""

#: ../../../onboarding/django.rst:1111
msgid ""
"class AuthMiddleware(ASGIMiddleware):\n"
"    exclude = [\"/health\", \"^/internal/\"]\n"
"    exclude_opt_key = \"no_auth\"\n"
"\n"
"@get(\"/login\", no_auth=True)\n"
"async def login() -> dict[str, str]:\n"
"    ..."
msgstr ""

#: ../../../onboarding/django.rst:1122
msgid ":doc:`/usage/middleware/creating-middleware`"
msgstr ""

#: ../../../onboarding/django.rst:1126
msgid "Signals and lifecycle hooks"
msgstr ""

#: ../../../onboarding/django.rst:1128
msgid ""
"Django signals (``pre_save``, ``post_save``, ``request_started``, "
"``request_finished``, and custom ``Signal`` instances) are an in-process "
"publish/subscribe bus that mixes request lifecycle with domain events. "
"Litestar exposes the request-lifecycle slice as **per-request hooks**: "
"``before_request``, ``after_request``, ``after_response``, and "
"``after_exception``, declared on any layer. They run on the request task and "
"can read or mutate the request and response."
msgstr ""

#: ../../../onboarding/django.rst:1136
msgid "The request-finished case maps to ``after_response``:"
msgstr ""

#: ../../../onboarding/django.rst:1144
msgid ""
"from django.core.signals import request_finished\n"
"from django.dispatch import receiver\n"
"\n"
"@receiver(request_finished)\n"
"def log_request(sender, **kwargs):\n"
"    ..."
msgstr ""

#: ../../../onboarding/django.rst:1156
msgid ""
"import logging\n"
"\n"
"from litestar import Litestar, Request, get\n"
"\n"
"logger = logging.getLogger(__name__)\n"
"\n"
"\n"
"def attach_user(request: Request) -> None:\n"
"    request.state[\"user\"] = request.headers.get(\"x-user\", "
"\"anonymous\")\n"
"\n"
"\n"
"def log_status(request: Request) -> None:\n"
"    \"\"\"``after_response`` runs after the response body is sent — good for "
"logging.\"\"\"\n"
"    logger.info(\"request to %s by %s\", request.url.path, request.state."
"get(\"user\"))\n"
"\n"
"\n"
"@get(\"/hello\")\n"
"async def hello(request: Request) -> dict[str, str]:\n"
"    return {\"user\": request.state[\"user\"]}\n"
"\n"
"\n"
"app = Litestar(\n"
"    route_handlers=[hello],\n"
"    before_request=attach_user,\n"
"    after_response=log_status,\n"
")"
msgstr ""

#: ../../../onboarding/django.rst:1158
msgid ""
"Domain events (``post_save``, custom ``Signal`` instances) have no first-"
"party Litestar equivalent. For in-process fan-out, call the service function "
"directly from the handler (or from a dependency it injects). For cross-"
"process fan-out, publish to a message broker (Redis pub/sub, NATS, RabbitMQ) "
"through a client wired up on the application."
msgstr ""

#: ../../../onboarding/django.rst:1166
msgid "Background tasks"
msgstr ""

#: ../../../onboarding/django.rst:1168
msgid ""
"Django 6 ships ``django.tasks``, a first-party task-queue interface with a "
"pluggable backend (in-memory, immediate, database, and third-party Celery / "
"RQ adapters). Tasks are declared with the ``@task`` decorator and submitted "
"through ``.enqueue(...)``. On earlier versions there was no first-party "
"option; Celery, RQ, django-q, and Huey covered the same ground."
msgstr ""

#: ../../../onboarding/django.rst:1174
msgid ""
"Litestar's :class:`~litestar.background_tasks.BackgroundTask` (or :class:"
"`~litestar.background_tasks.BackgroundTasks` collection) runs a callable "
"after the response body has been sent, attached to a :class:`~litestar."
"response.Response` through ``background=``. The two address different needs: "
"``django.tasks`` is a durable queue, ``BackgroundTask`` is in-process work "
"that should not block the response."
msgstr ""

#: ../../../onboarding/django.rst:1187
msgid ""
"# tasks.py\n"
"from django.tasks import task\n"
"\n"
"@task()\n"
"def send_welcome_email(email: str) -> None:\n"
"    ...\n"
"\n"
"# views.py\n"
"from .tasks import send_welcome_email\n"
"\n"
"def signup(request):\n"
"    email = request.POST[\"email\"]\n"
"    send_welcome_email.enqueue(email)\n"
"    return JsonResponse({\"status\": \"queued\"}, status=201)"
msgstr ""

#: ../../../onboarding/django.rst:1207
msgid ""
"import logging\n"
"\n"
"from litestar import Litestar, Response, post\n"
"from litestar.background_tasks import BackgroundTask\n"
"\n"
"logger = logging.getLogger(__name__)\n"
"\n"
"\n"
"async def send_welcome_email(address: str) -> None:\n"
"    logger.info(\"sending welcome email to %s\", address)\n"
"\n"
"\n"
"@post(\"/signup\")\n"
"async def signup(data: dict[str, str]) -> Response[dict[str, str]]:\n"
"    return Response(\n"
"        {\"status\": \"queued\"},\n"
"        background=BackgroundTask(send_welcome_email, data[\"email\"]),\n"
"    )\n"
"\n"
"\n"
"app = Litestar(route_handlers=[signup])"
msgstr ""

#: ../../../onboarding/django.rst:1209
msgid ""
"A ``BackgroundTask`` is not a job queue: it has no durability, no "
"scheduling, no retries, and no cross-process fan-out. If the worker process "
"dies before the task finishes, the task is lost. For durable jobs reach for "
"an external queue."
msgstr ""

#: ../../../onboarding/django.rst:1216
msgid ":ref:`usage/responses:background tasks`"
msgstr ""

#: ../../../onboarding/django.rst:1220
msgid "Database access"
msgstr ""

#: ../../../onboarding/django.rst:1222
msgid ""
"Litestar is ORM-agnostic. There is no built-in ORM and no required "
"integration: SQLAlchemy, Tortoise, Piccolo, Peewee, an async driver, or raw "
"SQL all work without framework cooperation. A handler that opens a "
"connection, runs a query, and returns a dict is a complete Litestar handler."
msgstr ""

#: ../../../onboarding/django.rst:1227
msgid ""
"The fullest first-party integration is the optional :class:"
"`~advanced_alchemy.extensions.litestar.SQLAlchemyPlugin`, built on `advanced-"
"alchemy <https://docs.advanced-alchemy.litestar.dev>`_. The plugin manages "
"the engine and session lifecycle, injects an ``AsyncSession`` per request "
"through the ``db_session`` dependency, ships a repository, and, through :"
"class:`~advanced_alchemy.extensions.litestar.SQLAlchemyDTO`, serialises "
"mapped models to JSON natively. Returning an ORM instance directly from a "
"handler works because the DTO reads the mapped columns and emits the schema "
"that Litestar uses for OpenAPI and the response body. No ``ModelSerializer`` "
"equivalent is needed."
msgstr ""

#: ../../../onboarding/django.rst:1238
msgid ""
"Other ORMs follow the same shape minus the plugin: register a startup hook "
"that opens the engine, provide a session-yielding dependency, and either "
"return data the model library already serialises (dataclasses, msgspec, "
"Pydantic) or write a thin DTO for the model type."
msgstr ""

#: ../../../onboarding/django.rst:0
msgid "Django + DRF"
msgstr ""

#: ../../../onboarding/django.rst:1249
msgid ""
"# models.py\n"
"from django.db import models\n"
"\n"
"class Item(models.Model):\n"
"    name = models.CharField(max_length=100)\n"
"\n"
"# serializers.py\n"
"class ItemSerializer(serializers.ModelSerializer):\n"
"    class Meta:\n"
"        model = Item\n"
"        fields = [\"id\", \"name\"]\n"
"\n"
"# views.py\n"
"class ItemViewSet(viewsets.ModelViewSet):\n"
"    queryset = Item.objects.all()\n"
"    serializer_class = ItemSerializer"
msgstr ""

#: ../../../onboarding/django.rst:1271
msgid ""
"from collections.abc import Sequence\n"
"from typing import Annotated\n"
"\n"
"from sqlalchemy import select\n"
"from sqlalchemy.ext.asyncio import AsyncSession\n"
"from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column\n"
"\n"
"from litestar import Litestar, get, post\n"
"from litestar.dto import DTOConfig\n"
"from litestar.plugins.sqlalchemy import (\n"
"    AsyncSessionConfig,\n"
"    SQLAlchemyAsyncConfig,\n"
"    SQLAlchemyDTO,\n"
"    SQLAlchemyPlugin,\n"
")\n"
"\n"
"\n"
"class Base(DeclarativeBase):\n"
"    pass\n"
"\n"
"\n"
"class Item(Base):\n"
"    __tablename__ = \"migration_items\"\n"
"    id: Mapped[int] = mapped_column(primary_key=True, autoincrement=True)\n"
"    name: Mapped[str]\n"
"\n"
"\n"
"WriteItemDTO = SQLAlchemyDTO[Annotated[Item, DTOConfig(exclude={\"id\"})]]\n"
"ReadItemDTO = SQLAlchemyDTO[Item]\n"
"\n"
"\n"
"@post(\"/items\", dto=WriteItemDTO, return_dto=ReadItemDTO)\n"
"async def create_item(data: Item, db_session: AsyncSession) -> Item:\n"
"    async with db_session.begin():\n"
"        db_session.add(data)\n"
"    return data\n"
"\n"
"\n"
"@get(\"/items\", return_dto=ReadItemDTO)\n"
"async def list_items(db_session: AsyncSession) -> Sequence[Item]:\n"
"    return (await db_session.execute(select(Item))).scalars().all()\n"
"\n"
"\n"
"config = SQLAlchemyAsyncConfig(\n"
"    connection_string=\"sqlite+aiosqlite:///:memory:\",\n"
"    create_all=True,\n"
"    metadata=Base.metadata,\n"
"    session_config=AsyncSessionConfig(expire_on_commit=False),\n"
")\n"
"app = Litestar(\n"
"    route_handlers=[create_item, list_items],\n"
"    plugins=[SQLAlchemyPlugin(config=config)],\n"
")"
msgstr ""

