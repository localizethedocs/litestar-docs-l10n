#: ../../../release-notes/changelog.rst:1338
msgid ""
"Add a new :func:`~litestar.handlers.websocket_stream` route handler that "
"supports streaming data *to* a WebSocket via an async generator."
msgstr ""

#: ../../../release-notes/changelog.rst:1342
msgid ""
"@websocket_stream(\"/\")\n"
"async def handler() -> AsyncGenerator[str, None]:\n"
"    yield str(time.time())\n"
"    await asyncio.sleep(.1)"
msgstr ""

#: ../../../release-notes/changelog.rst:1349
msgid "This is roughly equivalent to (with some edge case handling omitted):"
msgstr ""

#: ../../../release-notes/changelog.rst:1352
msgid ""
"@websocket(\"/\")\n"
"async def handler(socket: WebSocket) -> None:\n"
"  await socket.accept()\n"
"\n"
"  try:\n"
"    async with anyio.task_group() as tg:\n"
"      # 'receive' in the background to catch client disconnects\n"
"      tg.start_soon(socket.receive)\n"
"\n"
"      while True:\n"
"        socket.send_text(str(time.time()))\n"
"        await asyncio.sleep(.1)\n"
"  finally:\n"
"    await socket.close()"
msgstr ""

#: ../../../release-notes/changelog.rst:1369
msgid ""
"Just like the WebSocket listeners, it also supports dependency injection and "
"serialization:"
msgstr ""

#: ../../../release-notes/changelog.rst:1373
msgid ""
"@dataclass\n"
"class Event:\n"
"    time: float\n"
"    data: str\n"
"\n"
"\n"
"async def provide_client_info(socket: WebSocket) -> str:\n"
"    return f\"{socket.client.host}:{socket.client.port}\"\n"
"\n"
"\n"
"@websocket_stream(\"/\", dependencies={\"client_info\": "
"provide_client_info})\n"
"async def handler(client_info: str) -> AsyncGenerator[Event, None]:\n"
"    yield Event(time=time.time(), data=\"hello, world!\")\n"
"    await asyncio.sleep(.1)"
